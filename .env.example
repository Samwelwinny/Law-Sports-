# ============================================
# PROLEGIS SPORTS INTEGRITY PLATFORM
# ============================================

# Application Environment
NODE_ENV=production
PORT=5000
DOMAIN_NAME=prolegis.sports
SSL_EMAIL=admin@prolegis.sports

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prolegis
DB_USER=prolegis_admin
DB_PASSWORD=your_secure_password_here

# JWT & Encryption
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRY=7d
ENCRYPTION_KEY=your_256_bit_encryption_key_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Email Service (SendGrid/Mailgun)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASSWORD=your_sendgrid_api_key
EMAIL_FROM=noreply@prolegis.sports

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Video Conferencing (Agora)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate

# File Upload
MAX_FILE_SIZE=10485760 # 10MB
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# Frontend Configuration
REACT_APP_API_URL=https://api.prolegis.sports
REACT_APP_SOCKET_URL=wss://api.prolegis.sports
REACT_APP_AGORA_APP_ID=${AGORA_APP_ID}

# Security
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
SESSION_SECRET=your_session_secret
CORS_ORIGIN=https://prolegis.sports

# Monitoring
SENTRY_DSN=your_sentry_dsn_if_using
LOG_LEVEL=info

# Payment Gateway (Stripe)
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
```

6. DEPLOYMENT SCRIPTS

deploy.sh

```bash
#!/bin/bash

# ProLegis Deployment Script
set -e

echo "🚀 Starting ProLegis Platform Deployment..."

# Load environment variables
if [ -f .env ]; then
    export $(cat .env | grep -v '^#' | xargs)
else
    echo "❌ Error: .env file not found"
    exit 1
fi

# Check for required commands
command -v docker >/dev/null 2>&1 || { 
    echo "❌ Docker is required but not installed." 
    exit 1 
}

command -v docker-compose >/dev/null 2>&1 || { 
    echo "❌ Docker Compose is required but not installed." 
    exit 1 
}

# Create necessary directories
echo "📁 Creating directory structure..."
mkdir -p nginx/ssl nginx/logs backend/uploads database/backups

# Set proper permissions
echo "🔒 Setting permissions..."
chmod 755 backend/uploads
chmod 600 .env
chmod +x *.sh

# Build and start services
echo "🏗️  Building Docker images..."
docker-compose build

echo "🔄 Starting services..."
docker-compose up -d

# Wait for services to be healthy
echo "⏳ Waiting for services to be ready..."
sleep 30

# Run database migrations
echo "🗄️  Running database migrations..."
docker-compose exec backend npm run migrate

# Create admin user
echo "👨‍💼 Creating admin user..."
docker-compose exec backend node scripts/create-admin.js

# Generate SSL certificates if not exists
if [ ! -f "nginx/ssl/live/${DOMAIN_NAME}/fullchain.pem" ]; then
    echo "🔐 Generating SSL certificates..."
    docker-compose run --rm certbot
fi

# Restart nginx with SSL
echo "🔄 Restarting nginx with SSL..."
docker-compose restart nginx

# Run security scan
echo "🛡️  Running security scan..."
docker run --network prolegis_prolegis-network -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy image backend:latest

# Display deployment info
echo ""
echo "========================================="
echo "✅ DEPLOYMENT COMPLETE!"
echo "========================================="
echo ""
echo "🌐 Frontend URL: https://${DOMAIN_NAME}"
echo "🔧 Backend API: https://api.${DOMAIN_NAME}"
echo "🗄️  Database: postgres://${DB_HOST}:5432/${DB_NAME}"
echo "📱 Mobile App: Available on iOS & Android"
echo ""
echo "📊 Next steps:"
echo "1. Configure DNS to point to your server IP"
echo "2. Set up monitoring at https://${DOMAIN_NAME}/admin"
echo "3. Configure backup schedule in scripts/backup.sh"
echo "4. Test all endpoints with scripts/test-api.sh"
echo ""
echo "🚨 Emergency commands:"
echo "   View logs: docker-compose logs -f"
echo "   Restart: docker-compose restart"
echo "   Backup: ./scripts/backup.sh"
echo "   Update: ./scripts/update.sh"
echo ""
echo "========================================="