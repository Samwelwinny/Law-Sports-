# Application Environment
NODE_ENV=production
PORT=5000
DOMAIN_NAME=prolegis.sports
SSL_EMAIL=admin@prolegis.sports

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prolegis
DB_USER=prolegis_admin
DB_PASSWORD=your_secure_password_here

# JWT & Encryption
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRY=7d
ENCRYPTION_KEY=your_256_bit_encryption_key_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Email Service (SendGrid/Mailgun)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASSWORD=your_sendgrid_api_key
EMAIL_FROM=noreply@prolegis.sports

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Video Conferencing (Agora)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate

# File Upload
MAX_FILE_SIZE=10485760 # 10MB
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# Frontend Configuration
REACT_APP_API_URL=https://api.prolegis.sports
REACT_APP_SOCKET_URL=wss://api.prolegis.sports
REACT_APP_AGORA_APP_ID=${AGORA_APP_ID}

# Security
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
SESSION_SECRET=your_session_secret
CORS_ORIGIN=https://prolegis.sports

# Monitoring
SENTRY_DSN=your_sentry_dsn_if_using
LOG_LEVEL=info

# Payment Gateway (Stripe)
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
